# Server & Authentication Configuration
PORT=8000
AUTH_MODE=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Firebase Admin SDK Credentials (required when AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyLine1...\n-----END PRIVATE KEY-----\n"

# Skill Scoring Thresholds
WEAK_THRESHOLD=39.0
DEVELOPING_THRESHOLD=69.0
STRONG_THRESHOLD=84.0
PROFICIENT_THRESHOLD=100.0

# Optional LLM Integration Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
